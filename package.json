{
  "version": "1.3.1",
  "name": "passenger",
  "type": "module",
  "bin": {
    "passenger": "./dist/passenger.js"
  },
  "scripts": {
    "start": "tsx src/cli/cli.ts --help",
    "dev": "tsx src/cli/cli.ts",
    "build": "node build.js",
    "build:binary": "npm run build && pkg dist/passenger.js --targets node18-macos-x64,node18-linux-x64,node18-win-x64 --output bin/passenger",
    "prepublish": "npm run build"
  },
  "pkg": {
    "assets": [
      "node_modules/**/*"
    ],
    "outputPath": "bin"
  },
  "devDependencies": {
    "@types/asana": "^0.18.17",
    "@types/node": "^20.19.24",
    "@types/yargs": "17.0.24",
    "@yao-pkg/pkg": "^6.10.0",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@google/generative-ai": "^0.24.1",
    "@linear/sdk": "^40.0.0",
    "@types/inquirer": "^9.0.9",
    "asana": "^3.0.16",
    "chokidar": "^4.0.3",
    "dotenv": "^16.3.1",
    "file-system-cache": "^2.4.4",
    "inquirer": "^12.10.0",
    "jira.js": "^2.19.1",
    "octokit": "^3.1.1",
    "openai": "^4.14.2",
    "simple-git": "^3.29.0",
    "trello-node-api": "^0.0.9",
    "yargs": "17.7.2"
  }
}
